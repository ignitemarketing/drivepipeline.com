{
  "name": "drivepipeline.com",
  "private": true,
  "description": "Static site. style.css and fonts/ are generated and committed so the deploy needs no build step.",
  "scripts": {
    "build:fonts": "node scripts/copy-fonts.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o style.css --minify"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "tailwindcss": "3.4.17"
  }
}
